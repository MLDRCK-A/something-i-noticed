---
import { getCollection, render } from "astro:content";
import PieceLayout from "../../layouts/PieceLayout.astro";

export async function getStaticPaths() {
	const pieces = await getCollection("pieces");

	const visiblePieces = import.meta.env.PROD
		? pieces.filter((piece) => !piece.data.draft)
		: pieces;

	return visiblePieces.map((piece) => ({
		params: { id: piece.id },
		props: { piece },
	}));
}

const { piece } = Astro.props;
const { Content } = await render(piece);

const wordsPerMinute = 200;

const plainText = piece.body
	.replace(/```[\s\S]*?```/g, " ")
	.replace(/<[^>]*>/g, " ")
	.replace(/!\[([^\]]*)\]\([^)]*\)/g, " ")
	.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
	.replace(/[#*_>`~|]/g, " ");

const wordCount = plainText.trim() ? plainText.trim().split(/\s+/).length : 0;

const readingMinutes = Math.max(1, Math.ceil(wordCount / wordsPerMinute));
---

<PieceLayout
	title={piece.data.title}
	description={piece.data.description}
	number={piece.data.number}
	published={piece.data.published}
	readingMinutes={readingMinutes}
	socialImage={piece.data.socialImage}
	socialImageAlt={piece.data.socialImageAlt}
	epilogue={piece.data.epilogue}
>
	<Content />
</PieceLayout>
