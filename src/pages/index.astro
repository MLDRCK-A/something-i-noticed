---
import { getCollection } from "astro:content";

const pieces = (await getCollection("pieces"))
	.filter((piece) => !piece.data.draft)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>Something I Noticed</title>
		<meta
			name="description"
			content="Things I notice, and where they take me."
		/>
	</head>

	<body>
		<header class="hero">
			<div class="hero-copy">
				<h1>Something I <span>Noticed</span></h1>
				<p>Things I notice, and where they take me.</p>
			</div>

			<img
				class="hero-art"
				src="/images/site/home-banner.png"
				alt="A caveman and cat sitting beside a campfire, overlooking a distant city."
			/>
		</header>
		<main>
			<section class="latest">
				<h2>Latest</h2>

				<div class="piece-list">
					{
						pieces.length > 0 ? (
							pieces.map((piece) => (
								<article class="piece">
									<a href={`/pieces/${piece.id}/`}>
										<p class="piece-number">
											{String(piece.data.number).padStart(
												3,
												"0",
											)}
										</p>

										<h3>{piece.data.title}</h3>

										<p class="piece-description">
											{piece.data.description}
										</p>
									</a>
								</article>
							))
						) : (
							<p class="empty-state">
								The first piece is being written.
							</p>
						)
					}
				</div>
			</section>
		</main>

		<footer>
			<a href="/about/">About</a>
			<a href="/support/">Support</a>
		</footer>
	</body>

	<style>
		:global(*) {
			box-sizing: border-box;
		}

		:global(html) {
			background: #0b2118;
		}

		:global(body) {
			margin: 0;
			min-height: 100vh;
			background: #0b2118;
			color: #edf3ec;
			font-family: Arial, Helvetica, sans-serif;
			line-height: 1.6;
		}

		.hero,
		main,
		footer {
			width: min(100% - 3rem, 1100px);
			margin-inline: auto;
		}

		.hero {
			padding-block: 5rem 3rem;
		}

		.hero-copy {
			position: relative;
			z-index: 1;
		}

		.hero-art {
			display: block;
			width: 100%;
			height: auto;
			margin-top: 3rem;
		}

		h1 {
			max-width: 850px;
			margin: 0;
			font-size: clamp(3rem, 8vw, 7rem);
			font-weight: 600;
			letter-spacing: -0.05em;
			line-height: 0.95;
		}

		h1 span {
			display: block;
		}

		.hero-copy > p {
			max-width: 520px;
			margin-top: 2rem;
			color: #a9bcae;
			font-size: clamp(1rem, 2vw, 1.25rem);
		}

		h2 {
			margin: 0;
			color: #8fb59a;
			font-size: 0.8rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.18em;
		}

		.piece-list {
			margin-top: 2rem;
		}

		.piece {
			border-top: 1px solid rgba(237, 243, 236, 0.14);
		}

		.piece a {
			display: block;
			padding-block: 3rem;
			color: inherit;
			text-decoration: none;
		}

		.piece-number {
			margin: 0;
			color: #8fb59a;
			font-size: 0.85rem;
			letter-spacing: 0.08em;
		}

		.piece h3 {
			max-width: 850px;
			margin-block: 0.5rem;
			font-size: clamp(1.8rem, 4vw, 3rem);
			font-weight: 500;
			letter-spacing: -0.03em;
			line-height: 1.1;
		}

		.piece-description {
			max-width: 620px;
			margin-block: 0.75rem 0;
			color: #b9c8bd;
		}

		.piece a:hover h3,
		.piece a:focus-visible h3 {
			color: #b7d8bf;
		}

		.piece a:focus-visible {
			outline: 2px solid #b7d8bf;
			outline-offset: 0.5rem;
		}

		.empty-state {
			padding-block: 3rem;
			border-top: 1px solid rgba(237, 243, 236, 0.14);
			color: #b9c8bd;
		}

		footer {
			display: flex;
			gap: 1.5rem;
			margin-top: 6rem;
			padding-block: 3rem;
			border-top: 1px solid rgba(237, 243, 236, 0.14);
			color: #8fa197;
		}

		footer a {
			color: #8fa197;
			text-decoration: none;
		}

		footer a:hover,
		footer a:focus-visible {
			color: #edf3ec;
		}

		@media (max-width: 600px) {
			.hero,
			main,
			footer {
				width: min(100% - 2rem, 1100px);
			}

			.hero {
				padding-block: 3rem 2rem;
			}

			.hero-art {
				margin-top: 2.5rem;
			}

			h1 {
				font-size: clamp(3rem, 15vw, 4.5rem);
				line-height: 0.9;
			}

			.hero-copy > p {
				margin-top: 1.5rem;
				font-size: 1rem;
			}

			.piece a {
				padding-block: 2rem;
			}

			.piece h3 {
				font-size: 2rem;
			}
		}
	</style>
</html>
