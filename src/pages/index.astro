			font-family: Arial, Helvetica, sans-serif;
			line-height: 1.6;
		}

		header,
		main,
		footer {
			width: min(100% - 3rem, 1100px);
			margin-inline: auto;
		}

		header {
			min-height: 70vh;
			display: flex;
			flex-direction: column;
			justify-content: center;
			padding-block: 5rem;
		}

		h1 {
			max-width: 850px;
			margin: 0;
