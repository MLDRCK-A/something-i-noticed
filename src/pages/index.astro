			margin-top: 6rem;
			padding-block: 3rem;
			border-top: 1px solid rgba(237, 243, 236, 0.14);
			color: #8fa197;
		}

		@media (max-width: 600px) {
			header,
			main,
			footer {
				width: min(100% - 2rem, 1100px);
			}

			header {
				min-height: 60vh;
				padding-block: 3rem;
			}

			h1 {
				font-size: clamp(3rem, 15vw, 4.5rem);
				line-height: 0.9;
			}

			header p {
				margin-top: 1.5rem;
				font-size: 1rem;
			}

			article {
				padding-block: 2rem;
			}

			article h3 {
				font-size: 2rem;
			}
