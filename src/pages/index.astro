		}

		h2 {
			margin: 0;
			color: #8fb59a;
			font-size: 0.8rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.18em;
		}

		article {
			margin-top: 2rem;
			padding-block: 3rem;
			border-top: 1px solid rgba(237, 243, 236, 0.14);
		}

		article > p:first-child {
			color: #8fb59a;
			font-size: 0.85rem;
			letter-spacing: 0.08em;
		}

		article h3 {
			margin-block: 0.5rem;
			font-size: clamp(1.8rem, 4vw, 3rem);
			font-weight: 500;
			letter-spacing: -0.03em;
		}

		article p {
			max-width: 620px;
			margin-block: 0.75rem;
			color: #b9c8bd;
