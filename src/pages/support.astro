---
const pageTitle = "Support the Cave | Something I Noticed";
const pageDescription =
    "Support Something I Noticed with an optional one-time tip. The writing stays free for everyone.";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const socialImageURL = new URL("/images/site/home-banner.png", Astro.site);

const socialImageAlt =
    "A caveman and cat sitting beside a campfire, overlooking a distant city.";
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <title>{pageTitle}</title>
        <meta name="description" content={pageDescription} />

        <link rel="canonical" href={canonicalURL} />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="Something I Noticed" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={pageDescription} />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:image" content={socialImageURL} />
        <meta property="og:image:alt" content={socialImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={pageDescription} />
        <meta name="twitter:image" content={socialImageURL} />
        <meta name="twitter:image:alt" content={socialImageAlt} />

        <link
            rel="alternate"
            type="application/rss+xml"
            title="Something I Noticed"
            href="/rss.xml"
        />
    </head>

    <body>
        <nav>
            <a href="/">Something I Noticed</a>
        </nav>

        <main>
            <header>
                <p class="eyebrow">Support</p>
                <h1>Keep this going.</h1>
            </header>

            <section class="prose">
                <p>
                    Something I Noticed is free to read. There are no paywalls,
                    advertisements, or locked articles.
                </p>

                <p>
                    If something here was worth your time and you'd like to
                    support the writing, you can leave a one-time tip.
                </p>

                <div class="support-action">
                    <a
                        class="support-button"
                        href="https://buy.stripe.com/8x214hg0f3hNcFh8JybMQ00"
                    >
                        Support the writing
                    </a>
                </div>

                <figure class="support-art">
                    <img
                        src="/images/site/support-caveman.png"
                        alt="A winking caveman giving a thumbs up."
                    />
                </figure>

                <p>
                    Support is completely optional. Reading, sharing, or simply
                    thinking about something I wrote is already participation.
                </p>

                <p>
                    Support helps cover the small costs of keeping this place
                    running and gives me more room to keep writing.
                </p>

                <p>
                    And, realistically, some of it may become a matcha latte. 🍵
                </p>
            </section>
        </main>

        <footer>
            <a href="/">Back home</a>
        </footer>
    </body>
</html>

<style>
    :global(*) {
        box-sizing: border-box;
    }

    :global(html) {
        background: #0b2118;
    }

    :global(body) {
        margin: 0;
        min-height: 100vh;
        background: #0b2118;
        color: #edf3ec;
        font-family: Arial, Helvetica, sans-serif;
        line-height: 1.7;
    }

    nav,
    main,
    footer {
        width: min(100% - 3rem, 760px);
        margin-inline: auto;
    }

    nav {
        padding-block: 2rem;
    }

    a {
        color: #a9cbb2;
        text-decoration: none;
    }

    a:hover,
    a:focus-visible {
        color: #edf3ec;
    }

    header {
        padding-block: clamp(4rem, 12vw, 8rem);
    }

    .eyebrow {
        margin: 0 0 1rem;
        color: #8fb59a;
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.18em;
        text-transform: uppercase;
    }

    h1 {
        margin: 0;
        font-size: clamp(3rem, 9vw, 6rem);
        font-weight: 600;
        letter-spacing: -0.05em;
        line-height: 0.95;
    }

    .prose {
        max-width: 680px;
        font-size: clamp(1.05rem, 2vw, 1.2rem);
    }

    .prose p {
        margin-block: 0 1.5em;
        color: #c4d0c7;
    }

    .support-art {
        max-width: 420px;
        margin: 3rem auto 4rem;
    }

    .support-art img {
        display: block;
        width: 100%;
        height: auto;
    }

    .support-action {
        text-align: center;
    }

    .support-button {
        display: inline-block;
        margin-block: 0.5rem 2rem;
        padding: 0.85rem 1.2rem;
        border: 1px solid rgba(237, 243, 236, 0.3);
        border-radius: 0.4rem;
        background: #edf3ec;
        color: #0b2118;
        font-weight: 600;
        text-decoration: none;
    }

    .support-button:hover,
    .support-button:focus-visible {
        background: #dce8df;
        color: #0b2118;
    }

    h2 {
        margin-block: 3.5rem 1.25rem;
        color: #edf3ec;
        font-size: clamp(1.6rem, 4vw, 2.2rem);
        font-weight: 500;
        letter-spacing: -0.03em;
    }

    footer {
        margin-top: 6rem;
        padding-block: 3rem;
        border-top: 1px solid rgba(237, 243, 236, 0.14);
    }

    @media (max-width: 600px) {
        nav,
        main,
        footer {
            width: min(100% - 2rem, 760px);
        }

        header {
            padding-block: 4rem;
        }

        .support-art {
            margin-block: 2.5rem 3rem;
        }
    }
</style>
