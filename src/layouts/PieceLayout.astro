---
import ArticleEpilogue from "../components/ArticleEpilogue.astro";

const {
	title,
	description,
	number,
	published,
	readingMinutes,
	socialImage,
	socialImageAlt,
	epilogue,
} = Astro.props;

const pieceNumber = String(number).padStart(3, "0");

const formattedDate = published
	? published.toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
			timeZone: "UTC",
		})
	: null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(
	socialImage ?? "/images/social/default.png",
	Astro.site,
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{title} | Something I Noticed</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={canonicalURL} />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="Something I Noticed"
			href="/rss.xml"
		/>

		<meta property="og:type" content="article" />

		{
			published && (
				<meta
					property="article:published_time"
					content={published.toISOString()}
				/>
			)
		}

		<meta property="og:site_name" content="Something I Noticed" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />

		<meta property="og:image" content={socialImageURL} />
		{
			socialImageAlt && (
				<meta property="og:image:alt" content={socialImageAlt} />
			)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<meta name="twitter:image" content={socialImageURL} />
		{
			socialImageAlt && (
				<meta name="twitter:image:alt" content={socialImageAlt} />
			)
		}
	</head>

	<body>
		<section class="site-masthead">
			<nav>
				<a href="/">Something I Noticed</a>
			</nav>

			<div class="masthead-art">
				<img
					src="/images/site/home-banner.png"
					alt=""
					aria-hidden="true"
				/>
			</div>
		</section>

		<div class="article-transition top-transition" aria-hidden="true"></div>

		<main class="paper">
			<article>
				<header>
					<p class="piece-number">Piece {pieceNumber}</p>

					<h1>{title}</h1>

					<p class="description">{description}</p>

					<div class="article-meta">
						{
							published && formattedDate && (
								<time datetime={published.toISOString()}>
									{formattedDate}
								</time>
							)
						}

						{
							readingMinutes && (
								<span class="reading-time">
									{published && formattedDate && " · "}
									{readingMinutes} min read
								</span>
							)
						}
					</div>
				</header>

				<div class="prose">
					<slot />
				</div>
			</article>

			<div
				class="article-transition bottom-transition"
				aria-hidden="true"
			>
			</div>
		</main>

		<ArticleEpilogue
			message={epilogue?.message}
			supportText={epilogue?.supportText}
			image={epilogue?.image}
			imageAlt={epilogue?.imageAlt}
			showSupport={epilogue?.showSupport}
		/>
		<footer>
			<a href="/">Something I Noticed</a>
		</footer>
	</body>

	<style>
		:global(*) {
			box-sizing: border-box;
		}

		:global(html) {
			background: #0b2118;
		}

		:global(body) {
			margin: 0;
			background: #0b2118;
			color: #20251f;
			font-family: Georgia, "Times New Roman", serif;
			line-height: 1.75;
		}

		nav,
		.masthead-art,
		article,
		footer {
			width: min(100% - 3rem, 1100px);
			margin-inline: auto;
		}

		.site-masthead {
			background: #0b2118;
		}

		nav {
			padding-block: 2rem 1rem;
		}

		.masthead-art {
			max-width: 760px;
			padding-bottom: 0;
		}

		.masthead-art img {
			display: block;
			width: 100%;
			height: auto;
		}

		nav a,
		footer a {
			color: #a9cbb2;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 0.9rem;
			font-weight: 600;
			text-decoration: none;
		}
		nav a:hover,
		nav a:focus-visible,
		footer a:hover,
		footer a:focus-visible {
			color: #edf3ec;
		}

		.paper {
			width: 100%;
			background: #f2efe6;
		}
		.article-transition {
			position: relative;
			z-index: 2;
			width: 100%;
			height: clamp(60px, 10vw, 130px);
			background-repeat: no-repeat;
			background-position: center;
			background-size: 100% 100%;
			pointer-events: none;
		}

		.top-transition {
			display: none;
			margin-top: calc(-1 * clamp(60px, 10vw, 130px) * 0.75);
			margin-bottom: calc(-1 * clamp(60px, 10vw, 130px) * 0.25);
			background-image: url("/images/site/article-top-edge.png");
		}

		.bottom-transition {
			display: none;

			height: 60px;
			margin-top: -50px;
			margin-bottom: -31px;
			background-image: url("/images/site/article-bottom-grass.png?v=9");

			background-size: 100% 100%;
		}

		@media (min-width: 900px) {
			.bottom-transition {
				background-size: auto 100%;
				background-repeat: repeat-x;
				background-position: center center;
			}
		}

		article {
			width: min(100%, 720px);
			margin-inline: auto;
			padding-block: clamp(5rem, 10vw, 8rem);
		}

		header {
			margin-bottom: clamp(3rem, 8vw, 5rem);
		}

		.piece-number {
			margin: 0 0 1.25rem;
			color: #52735f;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 0.8rem;
			font-weight: 600;
			letter-spacing: 0.15em;
			text-transform: uppercase;
		}

		h1 {
			margin: 0;
			font-size: clamp(2.6rem, 7vw, 5.2rem);
			font-weight: 500;
			letter-spacing: -0.045em;
			line-height: 1;
		}

		.description {
			max-width: 640px;
			margin-block: 1.75rem 1rem;
			color: #596158;
			font-size: clamp(1.1rem, 2vw, 1.3rem);
			line-height: 1.55;
		}

		.article-meta {
			color: #778078;
			font-family: Arial, Helvetica, sans-serif;
			font-size: 0.85rem;
		}
=

		.prose {
			font-size: clamp(1.05rem, 1.5vw, 1.18rem);
		}

		.prose :global(p) {
			margin-block: 0 1.5em;
		}

		.prose :global(h2) {
			margin-block: 2.5em 0.75em;
			font-size: clamp(1.7rem, 4vw, 2.3rem);
			line-height: 1.2;
		}

		.prose :global(h3) {
			margin-block: 2em 0.75em;
			font-size: 1.4rem;
			line-height: 1.3;
		}

		.prose :global(img) {
			display: block;
			width: min(100%, 1000px);
			height: auto;
			margin-block: 3rem;
		}

		.prose :global(blockquote) {
			margin: 2.5rem 0;
			padding-left: 1.5rem;
			border-left: 2px solid #78927f;
			color: #4e574f;
			font-style: italic;
		}

		footer {
			padding-block: 3rem;
			border-top: 1px solid rgba(237, 243, 236, 0.14);
		}

		@media (max-width: 600px) {
			nav,
			.masthead-art,
			article,
			footer {
				width: min(100% - 2rem, 1100px);
			}

			nav {
				padding-block: 1.5rem;
			}

			article {
				padding-block: 5rem;
			}

			h1 {
				font-size: clamp(2.5rem, 13vw, 4rem);
			}
		}
	</style>
</html>
