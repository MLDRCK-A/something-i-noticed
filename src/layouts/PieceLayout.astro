---
const { title, description, number, published, socialImage } = Astro.props;

const pieceNumber = String(number).padStart(3, "0");

const formattedDate = published
	? published.toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
			timeZone: "UTC",
		})
	: null;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(
	socialImage ?? "/images/social/default.png",
	Astro.site,
);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />

		<title>{title} | Something I Noticed</title>
		<meta name="description" content={description} />

		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="article" />
		<meta property="og:site_name" content="Something I Noticed" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />

		<meta property="og:image" content={socialImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<meta name="twitter:image" content={socialImageURL} />
	</head>

	<body>
		<nav>
			<a href="/">Something I Noticed</a>
		</nav>

		<main>
			<article>
				<header>
					<p class="piece-number">Piece {pieceNumber}</p>

					<h1>{title}</h1>

					<p class="description">{description}</p>

					{
						published && formattedDate && (
							<time datetime={published.toISOString()}>
								{formattedDate}
							</time>
						)
					}
				</header>

				<div class="prose">
					<slot />
				</div>
			</article>
		</main>

		<footer>
			<a href="/">Something I Noticed</a>
		</footer>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #f2efe6;
	}

	:global(body) {
		margin: 0;
		background: #f2efe6;
		color: #20251f;
		font-family: Georgia, "Times New Roman", serif;
		line-height: 1.75;
	}

	nav,
	main,
	footer {
		width: min(100% - 3rem, 1100px);
		margin-inline: auto;
	}

	nav {
		padding-block: 2rem;
	}

	nav a,
	footer a {
		color: #315c45;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
	}

	article {
		width: min(100%, 720px);
		margin-inline: auto;
		padding-block: clamp(3rem, 8vw, 7rem);
	}

	header {
		margin-bottom: clamp(3rem, 8vw, 5rem);
	}

	.piece-number {
		margin: 0 0 1.25rem;
		color: #52735f;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.15em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(2.6rem, 7vw, 5.2rem);
		font-weight: 500;
		letter-spacing: -0.045em;
		line-height: 1;
	}

	.description {
		max-width: 640px;
		margin-block: 1.75rem 1rem;
		color: #596158;
		font-size: clamp(1.1rem, 2vw, 1.3rem);
		line-height: 1.55;
	}

	time {
		color: #778078;
		font-family: Arial, Helvetica, sans-serif;
		font-size: 0.85rem;
	}

	.prose {
		font-size: clamp(1.05rem, 1.5vw, 1.18rem);
	}

	.prose :global(p) {
		margin-block: 0 1.5em;
	}

	.prose :global(h2) {
		margin-block: 2.5em 0.75em;
		font-size: clamp(1.7rem, 4vw, 2.3rem);
		line-height: 1.2;
	}

	.prose :global(h3) {
		margin-block: 2em 0.75em;
		font-size: 1.4rem;
		line-height: 1.3;
	}

	.prose :global(img) {
		display: block;
		width: min(100%, 1000px);
		height: auto;
		margin-block: 3rem;
	}

	.prose :global(blockquote) {
		margin: 2.5rem 0;
		padding-left: 1.5rem;
		border-left: 2px solid #78927f;
		color: #4e574f;
		font-style: italic;
	}

	footer {
		margin-top: 4rem;
		padding-block: 3rem;
		border-top: 1px solid #d2d0c8;
	}

	@media (max-width: 600px) {
		nav,
		main,
		footer {
			width: min(100% - 2rem, 1100px);
		}

		nav {
			padding-block: 1.5rem;
		}

		article {
			padding-block: 3rem;
		}

		h1 {
			font-size: clamp(2.5rem, 13vw, 4rem);
		}
	}
</style>
