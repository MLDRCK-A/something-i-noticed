---
interface Props {
    message?: string;
    supportText?: string;
    image?: string;
    imageAlt?: string;
    showSupport?: boolean;
    articleTitle?: string;
}

const {
    message = "Thanks for reading.",
    supportText,
    image = "/images/site/support-caveman.png",
    imageAlt = "A friendly caveman giving a thumbs-up",
    showSupport = false,
    articleTitle,
} = Astro.props;

// Generate an email subject based on the article title.
const emailSubject = articleTitle
    ? `Thoughts on ${articleTitle}`
    : "Something I Noticed";

// Encode the subject so spaces and special characters work correctly.
const contactHref = `mailto:somethinginoticed@duck.com?subject=${encodeURIComponent(emailSubject)}`;
---

<section class="epilogue">
    <div class="epilogue-inner">
        <!-- Quiet invitation to respond -->
        <div class="contact-invitation">
            <p>
                <em>Noticed something or have a different perspective?</em>
                <a href={contactHref}>
                    Send it my way →
                </a>
            </p>
        </div>

        <!-- Customizable artwork and support message -->
        <div class="epilogue-content">
            <img src={image} alt={imageAlt} class="epilogue-art" />

            <h2>{message}</h2>

            {
                showSupport && (
                    <div class="support-invitation">
                        {supportText && <p>{supportText}</p>}

                        <a href="/support/" class="support-link">
                            Support the Cave →
                        </a>
                    </div>
                )
            }
        </div>
    </div>
</section>

<style>
    .epilogue {
        background: #0b2118;
        color: #edf3ec;
    }

    .epilogue-inner {
        width: min(100% - 3rem, 720px);
        margin-inline: auto;
        padding: 1rem 0 clamp(4rem, 8vw, 7rem);
        text-align: center;
    }

    /* Contact invitation */

    .contact-invitation {
        padding-bottom: 1rem;
        border-bottom: 1px solid rgba(169, 203, 178, 0.25);
    }

    .contact-invitation p {
        margin: 0;
        color: #a9cbb2;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 0.9rem;
        line-height: 1.7;
    }

    .contact-invitation em {
        font-style: italic;
    }

    .contact-invitation a {
        display: inline-block;
        margin-left: 0.25rem;
        color: #edf3ec;
        text-decoration: underline;
        text-underline-offset: 4px;
    }

    .contact-invitation a:hover,
    .contact-invitation a:focus-visible {
        color: #a9cbb2;
    }

    /* Customizable epilogue */

    .epilogue-content {
        padding-top: 1.5rem;
    }

    .epilogue-art {
        display: block;
        width: min(100%, 260px);
        height: auto;
        margin: 0 auto 2rem;
    }

    h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 400;
        line-height: 1.3;
    }

    /* Optional support */

    .support-invitation {
        margin-top: 1.5rem;
    }

    .support-invitation p {
        max-width: 520px;
        margin: 0 auto 1.5rem;
        color: #a9cbb2;
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .support-link {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border: 1px solid #a9cbb2;
        border-radius: 4px;
        color: #edf3ec;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .support-link:hover,
    .support-link:focus-visible {
        background: rgba(169, 203, 178, 0.12);
    }

    /* Mobile */

    @media (max-width: 600px) {
        .epilogue-inner {
            width: min(100% - 2rem, 720px);
        }
    }
</style>