---
interface Props {
    message?: string;
    supportText?: string;
    image?: string;
    imageAlt?: string;
    showSupport?: boolean;
}

const {
    message = "Thanks for reading.",
    supportText,
    image = "/images/site/support-caveman.png",
    imageAlt = "A friendly caveman giving a thumbs-up",
    showSupport = false,
} = Astro.props;
---

<section class="epilogue">
    <div class="epilogue-inner">
        <img
            src={image}
            alt={imageAlt}
            class="epilogue-art"
        />

        <h2>{message}</h2>

        {
            showSupport && (
                <div class="support-invitation">
                    {supportText && <p>{supportText}</p>}

                    <a href="/support/" class="support-link">
                        Support the Cave →
                    </a>
                </div>
            )
        }
    </div>
</section>

<style>
    .epilogue {
        background: #0b2118;
        color: #edf3ec;
    }

    .epilogue-inner {
        width: min(100% - 3rem, 720px);
        margin-inline: auto;
        padding-block: clamp(4rem, 8vw, 7rem);
        text-align: center;
    }

    .epilogue-art {
        display: block;
        width: min(100%, 260px);
        height: auto;
        margin: 0 auto 2rem;
    }

    h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 400;
        line-height: 1.3;
    }

    .support-invitation {
        margin-top: 1.5rem;
    }

    .support-invitation p {
        max-width: 520px;
        margin: 0 auto 1.5rem;
        color: #a9cbb2;
        font-size: 1.05rem;
        line-height: 1.7;
    }

    .support-link {
        display: inline-block;
        padding: 0.75rem 1.5rem;
        border: 1px solid #a9cbb2;
        border-radius: 4px;
        color: #edf3ec;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease;
    }

    .support-link:hover,
    .support-link:focus-visible {
        background: rgba(169, 203, 178, 0.12);
    }

    @media (max-width: 600px) {
        .epilogue-inner {
            width: min(100% - 2rem, 720px);
        }
    }
</style>
